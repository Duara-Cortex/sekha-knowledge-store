[Unit]
Description=Sekha Long-Term Memory Consolidation & Decay Daemon (Node 1)
Documentation=https://github.com/Duara-Cortex/sekha-knowledge-store
After=network.target network-online.target sekha-knowledge-store.service
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin
EnvironmentFile=-/etc/default/sekha
ExecStart=/usr/local/bin/sekha-consolidation -port 8085 -db /var/lib/sekha/knowledge.db -cycle 15m -decay-tau 72h -prune-threshold 0.10 -edge-prune-threshold 0.05 -grace-period 168h -hebbian-rate 0.15 -max-weight 5.0
Restart=always
RestartSec=3

# Resource and file limits
LimitNOFILE=65535

# Process sandbox protections
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/sekha

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sekha-consolidation

[Install]
WantedBy=multi-user.target
